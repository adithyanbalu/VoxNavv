{
  "manifest_version": 2,
  "name": "Context Before Consequence Interceptor",
  "version": "1.0",
  "description": "TEST: Intercepts all URLs to check content script injection",
  "permissions": [
    "scripting",
    "activeTab"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}